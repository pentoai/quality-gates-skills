{
	"threshold": 5,
	"minTokens": 50,
	"reporters": ["console"],
	"ignore": [
		"**/node_modules/**",
		"**/.next/**",
		"**/dist/**",
		"**/build/**",
		"**/coverage/**",
		"**/_generated/**",
		"**/*.test.ts",
		"**/*.test.tsx",
		".agents/**",
		".claude/**",
		"pnpm-lock.yaml",
		"package-lock.json",
		"yarn.lock",
		"bun.lock",
		"skills-lock.json"
	],
	"format": ["typescript", "tsx", "javascript", "jsx"]
}
